<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- 启用 WebSocket 支持（讨论室实时消息需要） -->
    <webSocket enabled="true" />
    <!-- 移除 WebDAV 模块（如已安装），避免拦截 DELETE/PUT 等方法 -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <!-- 允许所有 HTTP 方法通过请求筛选 -->
    <security>
      <requestFiltering>
        <verbs allowUnlisted="true">
          <add verb="DELETE" allowed="true" />
          <add verb="PUT" allowed="true" />
          <add verb="PATCH" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
    <handlers>
      <remove name="WebDAV" />
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="C:\Program Files\Python311\python.exe"
                  arguments="-m uvicorn backend.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --ws websockets"
                  stdoutLogEnabled="false"
                  stdoutLogFile="D:\SmartKBS\LogFiles\stdout.log"
                  startupTimeLimit="300"
                  processesPerApplication="1"
                  requestTimeout="00:15:00">
      <environmentVariables>
        <!-- DASHSCOPE_API_KEY：建议在系统环境变量中设置（系统级），修改后需重启 IIS -->
        <!-- JWT_SECRET_KEY：建议设置一个随机字符串作为系统环境变量，增强安全性 -->
        <environmentVariable name="TEMP" value="D:\SmartKBS\Temp" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>